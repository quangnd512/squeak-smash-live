# Copy to .env and fill in. NEVER commit .env.

# your domain (DNS A record -> the VPS IP)
DOMAIN=example.com

# long random values, e.g.:  openssl rand -hex 24   (use hex: other characters break the connection URL)
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# used to hash IP addresses before storing them:  openssl rand -hex 24
HASH_SECRET=change-me

# true when the site is behind Cloudflare (orange cloud). Then the real visitor IP comes from CF-Connecting-IP.
# Only turn this on if you also firewall the VPS so only Cloudflare can reach ports 80/443 (see README).
BEHIND_CLOUDFLARE=false

# Cloudflare Turnstile (free human check at sign-up). Leave empty to switch it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Players board: all = best round ever, month = best round this month
PLAYERS_BOARD_SCOPE=all

# Optional anti-abuse knobs (0 = off)
DAILY_ROUND_CAP=0
# a player is blocked after this many rejected (cheating-looking) rounds
MAX_STRIKES=5

# Extra Content-Security-Policy sources when you add Google AdSense (see README), space separated. Example:
# CSP_SCRIPT=https://pagead2.googlesyndication.com https://www.googletagservices.com https://adservice.google.com https://*.g.doubleclick.net https://*.googlesyndication.com
# CSP_FRAME=https://googleads.g.doubleclick.net https://*.googlesyndication.com https://tpc.googlesyndication.com
# CSP_IMG=https://*.googlesyndication.com https://*.g.doubleclick.net https://pagead2.googlesyndication.com
# CSP_CONNECT=https://pagead2.googlesyndication.com https://*.g.doubleclick.net https://adservice.google.com
